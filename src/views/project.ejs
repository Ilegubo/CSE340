<%- include('partials/header') %>
    <main id="main-content" tabindex="-1">
        <ul class="project-list">
            <% projectDetails.forEach(property => { %>
                <h1><%= title %></h1>
                <li>
                    <div class="project-meta">
                        <time datetime="<%= property.date %>"><%= property.date %></time>
                        <span><a href="/organization/<%=property.organization_id %>" class="project-organization"><%= property.organization_name %></a></span>
                        <!-- <span><%= property.location %></span> -->
                        </div>
                    <h2><%= property.title %></h2>
                    <p><%= property.description %></p>
                    <p><span class="tag">Location:</span> <%= property.location %></p>
                    <p><span class="tag">Category:</span><a class="no-styling-link" href="/category/<%= property.category_id %>"><%= property.category_name %><span>&rarr;</span></a></p>
                    <br>
                    <p><a class="details-link" href="/projects %>">&larr; Go back</a></p>

                </li>
            <% }) %>
        </ul>
    </main>
<%- include('partials/footer') %>