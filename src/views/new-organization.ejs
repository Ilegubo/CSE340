<%- include('partials/header') %>
<main id="main-content" tabindex="-1">
    <h1><%= title %></h1>

 <form class="organization-form" action="/new-organization" method="POST">
    <div class="form-group">
      <label for="name">Organization Name <span aria-hidden="true">(required)</span></label>
      <input
        type="text"
        id="name"
        name="name"
        autocomplete="organization"
        maxlength="150"
        required
      />
    </div>

    <div class="form-group">
      <label for="description">Description <span aria-hidden="true">(required)</span></label>
      <textarea
        id="description"
        name="description"
        required
      ></textarea>
    </div>

    <div class="form-group">
      <label for="contactEmail">Contact Email <span aria-hidden="true">(required)</span></label>
      <input
        type="email"
        id="contactEmail"
        name="contactEmail"
        autocomplete="email"
        maxlength="255"
        required
      />
    </div>

    <button type="submit">Create Organization</button>
  </form>

</main>
<%- include('partials/footer') %>