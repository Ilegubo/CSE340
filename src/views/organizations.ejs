<%- include('partials/header') %>

<main id="main-content" tabindex="-1">
    <h1><%= title %></h1>
    <p>Meet the organizations working with volunteers to support their communities.</p>

<ul class="organization-list">
    <% organizations.forEach(organization => { %>
        <li>
            <img src="/images/<%= organization.logo_filename %>" alt="" width="80" height="80" loading="lazy">
            <div>
                <h2><%= organization.name %></h2>
                <p><%= organization.description %></p>
                <a href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a>
            </div>
        </li>
    <% }); %>
</ul>
</main>

<%- include('partials/footer') %>