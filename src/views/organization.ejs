<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= organizationDetails.name %></h2>
    <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">

    <p>Description: <%= organizationDetails.description %></p>

    <h3>Service Projects</h3>
    <br>
    <ul class="project-list">
        <a class="details-link" href="organizations.ejs">&larr; Go Back</a>
        <% projects.forEach(project => { %>
            <li>
                <div class="project-meta">
                    <time datetime="<%= project.date %>"><%= project.date %></time>
                    <% if (project.location) { %><span><%= project.location %></span><% } %>
                </div>
                <h2><%= project.title %></h2>
                <p><%= project.description %></p>
                <p class="category-card--<%= project.category.toLowerCase() %>"><%= project.category %></p>
                
            </li>
        <% }) %>
    </ul>
</main>
<%- include('partials/footer') %>